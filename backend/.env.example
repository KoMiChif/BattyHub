# Copy this file to .env and fill in real values
NODE_ENV=development
PORT=4000

# Postgres connection string
# Local Docker: postgresql://battyhub:battyhub@localhost:5432/battyhub
# Hosted (Neon/Supabase/Railway): paste their provided URL
DATABASE_URL=postgresql://battyhub:battyhub@localhost:5432/battyhub

# JWT — generate a strong random string for production
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — your Next.js frontend origin(s), comma-separated
CORS_ORIGIN=http://localhost:3000

# Stripe — get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
